[Desktop Entry]
Name=systemd Pilot
Comment=Manage systemd services locally and over SSH
Exec=systemd-pilot
Icon=io.github.mfat.systemdpilot
Terminal=false
Type=Application
Categories=GTK;GNOME;System;
# Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
Keywords=systemd;service;daemon;unit;systemctl;journal;ssh;
StartupNotify=true
DBusActivatable=false
