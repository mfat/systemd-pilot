<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="systemd-pilot">
  <schema id="io.github.mfat.systemdpilot" path="/io/github/mfat/systemdpilot/">
    <key name="window-width" type="i">
      <default>1000</default>
    </key>
    <key name="window-height" type="i">
      <default>680</default>
    </key>
    <key name="window-maximized" type="b">
      <default>false</default>
    </key>
    <key name="show-inactive" type="b">
      <default>false</default>
      <summary>Show inactive units</summary>
      <description>Also list units that are loaded but not active, and installed units that are not loaded.</description>
    </key>
    <key name="color-scheme" type="s">
      <choices>
        <choice value="default"/>
        <choice value="light"/>
        <choice value="dark"/>
      </choices>
      <default>"default"</default>
      <summary>Color scheme</summary>
    </key>
    <key name="unit-label-order" type="s">
      <choices>
        <choice value="description-name"/>
        <choice value="name-description"/>
      </choices>
      <default>"name-description"</default>
      <summary>Unit label order</summary>
      <description>Whether the unit list shows description then name, or name then description.</description>
    </key>
  </schema>
</schemalist>
